{
  "name": "saos10-node-launchpad",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "SAOS10 Node Launchpad (SNL): SAOS 10 quickstart guide and node configuration tools",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "package": "scripts/stage-site.sh site && node bin/package.js site release",
    "test": "node --test",
    "changelog:check": "node bin/changelog.js check",
    "changelog:pr-body": "node bin/changelog.js pr-body",
    "changelog:notes": "node bin/changelog.js notes",
    "changelog:release-check": "node bin/changelog.js release-check"
  },
  "dependencies": {
    "dompurify": "^3.2.7",
    "lucide-react": "^0.468.0",
    "marked": "^14.1.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.5"
  }
}
